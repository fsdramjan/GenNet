<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Floating overlay (PIP-style live traffic panel) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Installed launcher apps -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name="${applicationName}"
        android:label="AppTrack"
        android:icon="@android:drawable/sym_def_app_icon"
        android:allowBackup="true"
        android:supportsRtl="true">

        <!-- Flutter -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            Old NetworkStats based usage service.
            Keep this only if your Flutter code still uses it.
        -->
        <service
            android:name=".AppTrackUsageService"
            android:exported="false"
            android:foregroundServiceType="specialUse">

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="app network usage monitoring" />

        </service>

        <!--
            AppTrack local VPN/TUN monitor.

            BIND_VPN_SERVICE is mandatory.
            Android calls VpnService.onBind() internally.
        -->
        <service
            android:name=".AppTrackVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false"
            android:foregroundServiceType="specialUse">

            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local network diagnostics and packet metadata display" />

        </service>

        <!--
            SOCKS5 relay, running in an ISOLATED process (":socks5").

            hev-socks5-server.so and hev-socks5-tunnel.so both statically
            link the same internal coroutine runtime. Loaded together in
            one process their global state collides and kills whichever
            one started first within a few hundred ms. Running this one
            in its own process gives it a separate address space, so
            there's no collision. They still talk over TCP loopback
            (127.0.0.1:1080) exactly as before.
        -->
        <service
            android:name=".Socks5ProcessService"
            android:exported="false"
            android:process=":socks5"
            android:foregroundServiceType="specialUse">

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local socks5 relay for on-device traffic monitoring" />

        </service>

        <!--
            Floating "PIP-style" overlay showing live captured traffic on
            top of other apps (similar to Reqable's debug panel).
            Requires SYSTEM_ALERT_WINDOW, requested at runtime.
        -->
        <service
            android:name=".OverlayService"
            android:exported="false" />

        <!-- Flutter embedding v2 -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>

</manifest>